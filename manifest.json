{
  "manifest_version": 3,
  "name": "GB Experiment QR",
  "version": "2.2.0",
  "description": "Generate QR codes for GrowthBook experiment variants.",
  "action": {
    "default_title": "GB QR",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "contextMenus", "tabs", "windows"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "128": "icon.png"
  }
}